# Copiar como .env. El archivo .env no se sube al repositorio.
# Conexión a la instancia local con autenticación de Windows. No lleva usuario ni contraseña.

SQL_SERVER=.\SQLTANIA
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_TRUST_SERVER_CERTIFICATE=yes

SQL_SOURCE_DB=WideWorldImporters
SQL_STAGING_DB=WWI_Staging
SQL_DW_DB=WWI_DW
